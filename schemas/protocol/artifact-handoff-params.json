{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactHandoffParams",
  "type": "object",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "attachId": {
      "type": "string"
    }
  },
  "required": [
    "attachId",
    "artifact"
  ],
  "$defs": {
    "ArtifactRecord": {
      "description": "Normalized record for an artifact that already exists on the frontend's\nhost. The artifact bytes remain local and are transferred by the core.",
      "type": "object",
      "properties": {
        "configuration": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentHash": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "symbolsPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetName": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "targetName",
        "size",
        "contentHash"
      ]
    }
  }
}
