{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HardwareDescriptor",
  "type": "object",
  "properties": {
    "boardId": {
      "type": [
        "string",
        "null"
      ]
    },
    "boardRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "deviceId": {
      "description": "Stable board identity; required for identity pinning when present.",
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocolVersion": {
      "description": "Version of the descriptor format itself.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "socId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
