{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorParams",
  "type": "object",
  "properties": {
    "error": {
      "$ref": "#/$defs/RpcError"
    },
    "requestId": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProgressToken"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "error"
  ],
  "$defs": {
    "ProgressToken": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "RpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int64"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/RpcErrorData"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "RpcErrorData": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": "string"
        },
        "remediation": {
          "description": "Stable action identifier for frontend-specific presentation.",
          "type": "string"
        },
        "retriable": {
          "type": "boolean"
        },
        "targetState": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "phase",
        "retriable",
        "remediation"
      ]
    }
  }
}
