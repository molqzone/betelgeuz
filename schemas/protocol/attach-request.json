{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttachRequest",
  "type": "object",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/ProfileCatalog"
    },
    "credentialSecrets": {
      "anyOf": [
        {
          "$ref": "#/$defs/CredentialSecrets"
        },
        {
          "type": "null"
        }
      ]
    },
    "strategyConfiguration": {
      "default": null
    },
    "strategyId": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/TargetOverrides"
    }
  },
  "additionalProperties": false,
  "required": [
    "catalog",
    "target",
    "strategyId"
  ],
  "$defs": {
    "CredentialMaterial": {
      "description": "The secrets for one credential reference: an account password and/or the\npassphrase of a private key.",
      "type": "object",
      "properties": {
        "passphrase": {
          "anyOf": [
            {
              "$ref": "#/$defs/SensitiveString"
            },
            {
              "type": "null"
            }
          ]
        },
        "password": {
          "anyOf": [
            {
              "$ref": "#/$defs/SensitiveString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CredentialSecrets": {
      "description": "One-use values indexed by the profile credential reference. This allows a\ntarget and each typed proxy hop to use different protected credentials.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CredentialMaterial"
      }
    },
    "ProfileCatalog": {
      "description": "User-level named SSH profiles keyed by the name selected in a workspace.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/TargetProfile"
      }
    },
    "ProxyHopProfile": {
      "description": "One configured jump host. Every hop has its own credential reference and\npinned SSH host key; arbitrary proxy commands are not accepted.",
      "type": "object",
      "properties": {
        "credentialRef": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "hostKey": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "default": 22,
          "maximum": 65535,
          "minimum": 0
        },
        "username": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "username",
        "credentialRef",
        "hostKey"
      ]
    },
    "SensitiveString": {
      "description": "One-use secret material supplied from frontend protected storage. It is\nnever persisted with the profile or echoed in protocol results.",
      "type": "string"
    },
    "TargetOverrides": {
      "description": "Workspace-scoped values that override a named profile when populated.",
      "type": "object",
      "properties": {
        "boardId": {
          "type": [
            "string",
            "null"
          ]
        },
        "credentialRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "keepaliveSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "proxyChain": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ProxyHopProfile"
          }
        },
        "socId": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "TargetProfile": {
      "description": "Target connection settings and board identity pins. Secret material stays\nin protected credential storage; `credential_ref` is only a lookup key.",
      "type": "object",
      "properties": {
        "boardId": {
          "type": [
            "string",
            "null"
          ]
        },
        "credentialRef": {
          "type": "string"
        },
        "deviceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": "string"
        },
        "hostKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "keepaliveSeconds": {
          "type": "integer",
          "format": "uint16",
          "default": 30,
          "maximum": 65535,
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "default": 22,
          "maximum": 65535,
          "minimum": 0
        },
        "proxyChain": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ProxyHopProfile"
          }
        },
        "socId": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "username",
        "credentialRef"
      ]
    }
  }
}
