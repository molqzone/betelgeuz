{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProxyHopProfile",
  "description": "One configured jump host. Every hop has its own credential reference and\npinned SSH host key; arbitrary proxy commands are not accepted.",
  "type": "object",
  "properties": {
    "credentialRef": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "hostKey": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "format": "uint16",
      "default": 22,
      "maximum": 65535,
      "minimum": 0
    },
    "username": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "host",
    "username",
    "credentialRef",
    "hostKey"
  ]
}
