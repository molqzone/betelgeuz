{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifiedTargetIdentity",
  "description": "Identity captured after the SSH host key is pinned or explicitly enrolled\nand the hardware descriptor is read over that verified session.",
  "type": "object",
  "properties": {
    "descriptor": {
      "$ref": "#/$defs/HardwareDescriptor"
    },
    "host": {
      "type": "string"
    },
    "hostKeyFingerprint": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "required": [
    "host",
    "port",
    "hostKeyFingerprint",
    "descriptor"
  ],
  "$defs": {
    "HardwareDescriptor": {
      "type": "object",
      "properties": {
        "boardId": {
          "type": [
            "string",
            "null"
          ]
        },
        "boardRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceId": {
          "description": "Stable board identity; required for identity pinning when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "description": "Version of the descriptor format itself.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "socId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
