{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgressParams",
  "type": "object",
  "properties": {
    "token": {
      "$ref": "#/$defs/ProgressToken"
    },
    "value": {
      "$ref": "#/$defs/ProgressValue"
    }
  },
  "required": [
    "token",
    "value"
  ],
  "$defs": {
    "ProgressToken": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "ProgressValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cancellable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "begin"
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "percentage": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "report"
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "percentage": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "end"
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    }
  }
}
