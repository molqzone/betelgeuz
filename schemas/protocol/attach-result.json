{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttachResult",
  "type": "object",
  "properties": {
    "attachId": {
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/VerifiedTargetIdentity"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TargetOperation"
      }
    },
    "profile": {
      "$ref": "#/$defs/ResolvedProfile"
    },
    "state": {
      "$ref": "#/$defs/ConnectionState"
    },
    "strategyId": {
      "type": "string"
    }
  },
  "required": [
    "attachId",
    "state",
    "profile",
    "identity",
    "strategyId",
    "operations"
  ],
  "$defs": {
    "ConnectionState": {
      "description": "Connection state of an attach. Each state may carry an optional `lastError`\ncatalog code at the API level; failure is a presentation decision, not a\nseparate state.",
      "type": "string",
      "enum": [
        "disconnected",
        "connecting",
        "attached",
        "reconnecting"
      ]
    },
    "HardwareDescriptor": {
      "type": "object",
      "properties": {
        "boardId": {
          "type": [
            "string",
            "null"
          ]
        },
        "boardRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceId": {
          "description": "Stable board identity; required for identity pinning when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "description": "Version of the descriptor format itself.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "socId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ResolvedProfile": {
      "type": "object",
      "properties": {
        "boardId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": "string"
        },
        "hostKeyPinned": {
          "type": "boolean"
        },
        "keepaliveSeconds": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "profileName": {
          "type": [
            "string",
            "null"
          ]
        },
        "proxyHops": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "socId": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "port",
        "username",
        "hostKeyPinned",
        "keepaliveSeconds",
        "proxyHops"
      ]
    },
    "TargetOperation": {
      "type": "string",
      "enum": [
        "deploy",
        "start",
        "stop",
        "restart",
        "restorePrevious",
        "logs",
        "debugPrepare"
      ]
    },
    "VerifiedTargetIdentity": {
      "description": "Identity captured after the SSH host key is pinned or explicitly enrolled\nand the hardware descriptor is read over that verified session.",
      "type": "object",
      "properties": {
        "descriptor": {
          "$ref": "#/$defs/HardwareDescriptor"
        },
        "host": {
          "type": "string"
        },
        "hostKeyFingerprint": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "host",
        "port",
        "hostKeyFingerprint",
        "descriptor"
      ]
    }
  }
}
