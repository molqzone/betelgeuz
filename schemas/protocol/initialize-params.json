{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InitializeParams",
  "description": "Frontend hello: carries the protocol version the frontend was built against.",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "frontend": {
      "description": "Frontend identity, e.g. `vscode`, `cli`.",
      "type": "string"
    },
    "protocolVersion": {
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "frontend"
  ]
}
