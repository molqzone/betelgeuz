{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResolvedProfile",
  "type": "object",
  "properties": {
    "boardId": {
      "type": [
        "string",
        "null"
      ]
    },
    "deviceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "host": {
      "type": "string"
    },
    "hostKeyPinned": {
      "type": "boolean"
    },
    "keepaliveSeconds": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "port": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "profileName": {
      "type": [
        "string",
        "null"
      ]
    },
    "proxyHops": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "socId": {
      "type": [
        "string",
        "null"
      ]
    },
    "username": {
      "type": "string"
    }
  },
  "required": [
    "host",
    "port",
    "username",
    "hostKeyPinned",
    "keepaliveSeconds",
    "proxyHops"
  ]
}
