{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DebugPrepareResult",
  "type": "object",
  "properties": {
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "program": {
      "type": [
        "string",
        "null"
      ]
    },
    "providerId": {
      "type": "string"
    },
    "symbolsPath": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "providerId",
    "host",
    "port"
  ]
}
