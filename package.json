{
  "name": "betelgeuz",
  "displayName": "Betelgeuz",
  "description": "Betelgeuz VS Code extension.",
  "version": "0.0.1",
  "publisher": "betelgeuz",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/betelgeuz/betelgeuz"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "betelgeuz.selectSshTarget",
        "title": "Betelgeuz: Select SSH Target"
      },
      {
        "command": "betelgeuz.connect",
        "title": "Betelgeuz: Connect"
      },
      {
        "command": "betelgeuz.disconnect",
        "title": "Betelgeuz: Disconnect"
      },
      {
        "command": "betelgeuz.inspectAttach",
        "title": "Betelgeuz: Inspect Attach"
      },
      {
        "command": "betelgeuz.deploy",
        "title": "Betelgeuz: Deploy"
      },
      {
        "command": "betelgeuz.start",
        "title": "Betelgeuz: Start"
      },
      {
        "command": "betelgeuz.stop",
        "title": "Betelgeuz: Stop"
      },
      {
        "command": "betelgeuz.restart",
        "title": "Betelgeuz: Restart"
      },
      {
        "command": "betelgeuz.status",
        "title": "Betelgeuz: Status"
      },
      {
        "command": "betelgeuz.logs",
        "title": "Betelgeuz: Logs"
      }
    ],
    "configuration": {
      "title": "Betelgeuz",
      "properties": {
        "betelgeuz.profiles": {
          "type": "object",
          "default": {},
          "scope": "application",
          "markdownDescription": "Named SSH profiles shared by workspaces. Store passwords, private keys, and passphrases through Betelgeuz commands so they remain in VS Code SecretStorage.",
          "additionalProperties": {
            "type": "object",
            "required": ["host", "username", "credentialRef"],
            "properties": {
              "host": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "username": { "type": "string" },
              "credentialRef": { "type": "string" },
              "hostKey": { "type": "string" },
              "deviceId": { "type": "string" },
              "boardId": { "type": "string" },
              "socId": { "type": "string" },
              "keepaliveSeconds": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "proxyChain": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["host", "username", "credentialRef", "hostKey"],
                  "properties": {
                    "host": { "type": "string" },
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                    "username": { "type": "string" },
                    "credentialRef": { "type": "string" },
                    "hostKey": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "betelgeuz.target.profile": {
          "type": "string",
          "scope": "resource",
          "markdownDescription": "User-level Betelgeuz profile selected for this workspace folder."
        },
        "betelgeuz.target.host": { "type": "string", "scope": "resource" },
        "betelgeuz.target.port": { "type": "integer", "minimum": 1, "maximum": 65535, "scope": "resource" },
        "betelgeuz.target.username": { "type": "string", "scope": "resource" },
        "betelgeuz.target.credentialRef": { "type": "string", "scope": "resource" },
        "betelgeuz.target.hostKey": { "type": "string", "scope": "resource" },
        "betelgeuz.target.deviceId": { "type": "string", "scope": "resource" },
        "betelgeuz.target.boardId": { "type": "string", "scope": "resource" },
        "betelgeuz.target.socId": { "type": "string", "scope": "resource" },
        "betelgeuz.target.keepaliveSeconds": { "type": "integer", "minimum": 1, "maximum": 65535, "scope": "resource" },
        "betelgeuz.target.proxyChain": { "type": "array", "items": { "type": "object" }, "scope": "resource" },
        "betelgeuz.attach.strategy": {
          "type": "string",
          "scope": "resource",
          "markdownDescription": "Deploy strategy selected for this workspace's attach."
        },
        "betelgeuz.deploy.localTarget": { "type": "string", "scope": "resource" },
        "betelgeuz.deploy.artifactPath": { "type": "string", "scope": "resource" },
        "betelgeuz.deploy.artifact": { "type": "string", "scope": "resource" },
        "betelgeuz.deploy.remotePath": { "type": "string", "scope": "resource" },
        "betelgeuz.deploy.executable": { "type": "string", "scope": "resource" },
        "betelgeuz.deploy.args": { "type": "array", "items": { "type": "string" }, "scope": "resource" },
        "betelgeuz.deploy.cwd": { "type": "string", "scope": "resource" },
        "betelgeuz.deploy.environment": { "type": "object", "scope": "resource" },
        "betelgeuz.deploy.fileMode": { "type": "string", "scope": "resource" },
        "betelgeuz.deploy.runCommand": { "type": "string", "scope": "resource" },
        "betelgeuz.deploy.runMode": { "type": "string", "scope": "resource" },
        "betelgeuz.deploy.serviceUnit": { "type": "string", "scope": "resource" },
        "betelgeuz.attach.linux.remoteproc.instance": { "type": "string", "scope": "resource" },
        "betelgeuz.attach.linux.remoteproc.firmwarePath": { "type": "string", "scope": "resource" }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsc -p ./ --watch",
    "check": "tsc -p ./ --noEmit",
    "package": "npm run compile",
    "test": "vitest run",
    "gen:errors": "tsx scripts/gen-errors.ts",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.95.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
